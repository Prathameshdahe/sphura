# Sphura frontend build settings (Vite exposes only VITE_* variables to the browser — never put secrets here).

# Backend origin when the API runs on another host (e.g. Render), without a trailing slash:
#   VITE_API_URL=https://your-backend.onrender.com
# Leave empty to call same-origin /api (Vite dev proxy, nginx in Docker, or the /api rewrite in vercel.json).
# A cross-origin API must allow this site in CORS with credentials, and set its session cookie with SameSite=None; Secure.
VITE_API_URL=

# Google sign-in needs no frontend variables: the Supabase URL and public anon key come from
# GET /api/auth/providers at runtime.
