# ─── Sphura configuration ────────────────────────────────────────────
# Copy to `.env` (same folder) and fill in what you have. Everything is optional:
# Sphura shows only the models whose keys / local servers are available.

# ── Cloud models (free tiers) ──
# Google AI Studio → https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Groq console → https://console.groq.com/keys
GROQ_API_KEY=
# NVIDIA API catalog → https://build.nvidia.com (sign in → any model → Get API Key; free developer credits)
NVIDIA_API_KEY=

# ── Local models (fallback / offline) ──
# Ollama: `ollama pull qwen3.5:4b` or `ollama pull nemotron-3-nano:4b` (both fit a 6 GB GPU).
# The fine-tuned `sphura-fin-1.7b` is created by training/sft/export.py. LM Studio: start the local server.
OLLAMA_BASE_URL=http://localhost:11434/v1
LMSTUDIO_BASE_URL=http://localhost:1234/v1

# ── One best model per provider ──
# The picker shows these three plus "Sphura Ensemble" (asks all three, then merges the answers).
# Each provider gets its own prompt size: cloud models the full context, the local 4B model a compact one.
# CURATED_MODELS=0 lists every model in the catalog instead.
CURATED_MODELS=1
GROQ_MODEL=openai/gpt-oss-120b
NVIDIA_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b
# Tried (in this order) when the NVIDIA model fails: Nemotron Lightning (fast), then DeepSeek V4.1 Flash.
NVIDIA_FAST_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
NVIDIA_FALLBACK_MODEL=deepseek-ai/deepseek-v4.1-flash
LOCAL_MODEL=qwen3.5:4b

# Model used when none is picked, as "<provider>:<model>". Empty = Sphura Ensemble when 2+ members are
# available, else the first available of Groq → NVIDIA → Gemini → local.
DEFAULT_MODEL=

# ── Web search ──
# Tavily → https://app.tavily.com (1,000 free searches/month) for finance news. Empty = DuckDuckGo fallback.
TAVILY_API_KEY=

# ── Security ──
# Empty in development = generated once and stored in backend/data/.jwt_secret.
# REQUIRED (32+ chars) when ENVIRONMENT=production.
JWT_SECRET=
ENVIRONMENT=development
# true behind https in production.
COOKIE_SECURE=false
# lax: the frontend reaches the API on its own origin (Vite proxy, Docker nginx, Vercel /api rewrite).
# none: the frontend calls the API on another domain via VITE_API_URL (implies Secure; set CORS_ORIGINS too).
COOKIE_SAMESITE=lax
# Browser origins allowed to call the API with credentials (comma-separated, never "*").
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Accounts: Supabase (Google sign-in + database) ──
# Project Settings → API: the project URL and the publishable (or legacy anon) key. Both are public by design.
# "Continue with Google" appears once Google is enabled under Authentication → Sign In / Providers.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Comma-separated admin emails (admins however they sign in). ADMIN_PASSWORD, if set, creates / resets the first
# admin's email + password login at start-up.
ADMIN_EMAILS=
ADMIN_PASSWORD=

# ── Storage (Docker sets these automatically) ──
# Empty DATABASE_URL = SQLite file in backend/data. Empty QDRANT_URL = embedded local Qdrant.
# Supabase: Connect → Session pooler URI (postgresql://… is fine; it is switched to the psycopg driver).
# Pick the region closest to you — every query is a network round trip (Mumbai ≈ 13 ms from India, Seoul ≈ 140 ms).
DATABASE_URL=
# Qdrant Cloud (free 1 GB cluster) keeps document vectors across redeploys on hosts with ephemeral disks.
QDRANT_URL=
QDRANT_API_KEY=
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
RERANKER_MODEL=Xenova/ms-marco-MiniLM-L-6-v2
MAX_UPLOAD_MB=25
